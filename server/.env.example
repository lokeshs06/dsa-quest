# Copy this file to .env and fill in the values.
PORT=5000

# Local MongoDB, or a MongoDB Atlas connection string:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dsa-quest
MONGO_URI=mongodb://127.0.0.1:27017/dsa-quest

# Any long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed by CORS and WebSockets (comma-separated). In production set this to your
# public URL, e.g. https://dsa-quest.onrender.com (or your Vercel URL when the client is hosted separately)
CLIENT_URL=http://localhost:5173

# In production the server refuses to start without a real MONGO_URI and a JWT_SECRET of 32+ characters.
# Behind a hosting proxy (Render, Railway, Fly) the first proxy hop is trusted for client IPs; change if needed:
# TRUST_PROXY=1

# Set to 1 to skip live LeetCode lookups (offline catalog only)
# LOOKUP_OFFLINE=1

# ---------------------------------------------------------------------------
# Everything below is OPTIONAL. Each feature switches itself off, and says so
# in the app, until its settings are filled in.
# ---------------------------------------------------------------------------

# The Oracle (AI hints and explanations). Get a key at https://console.anthropic.com
# Hints use Claude Opus 5.5; change MODEL in server/src/services/ai.service.js to use a cheaper model.
# ANTHROPIC_API_KEY=

# Code editor "Run" button and battles. In development, code runs on your own machine (python, node,
# gcc, g++, java) when Judge0 isn't set up. That runner has NO sandbox, so it is OFF in production
# unless you force it with ENABLE_LOCAL_RUNNER=true (don't, on a public server). Use Judge0 instead:
# ENABLE_LOCAL_RUNNER=false
#
# Judge0. Pick ONE of these:
#   a) Judge0 CE on RapidAPI: https://rapidapi.com/judge0-official/api/judge0-ce
# JUDGE0_API_KEY=
#   b) your own Judge0 server (JUDGE0_API_KEY is then optional and sent as X-Auth-Token)
# JUDGE0_URL=http://localhost:2358

# Email: password reset, email confirmation and weekly digests (any SMTP provider: Gmail app password, Resend, Mailgun, Brevo…).
# Without it, sign-up still works but "Forgot password?" says email isn't set up. Links in emails point at the first CLIENT_URL.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=hello@example.com
# Public URL of this API, used in the one-click unsubscribe link when the API and the
# frontend are on different hosts (defaults to CLIENT_URL):
# API_PUBLIC_URL=https://your-api.onrender.com
# While developing, print each email to the server log instead of sending it:
# EMAIL_TRANSPORT=json
